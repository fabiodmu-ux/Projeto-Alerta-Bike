# ============================================
# ALERTA BIKE - Backend Environment Variables
# ============================================

# Server Configuration
NODE_ENV=development
PORT=5000
HOST=localhost

# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alerta_bike
DB_USER=postgres
DB_PASSWORD=postgres
DB_URL=postgres://postgres:postgres@localhost:5432/alerta_bike

# MongoDB (Optional)
MONGO_URL=mongodb://localhost:27017/alerta_bike

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_HOST=localhost

# JWT Configuration
JWT_SECRET=sua_chave_secreta_super_segura_aqui
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=sua_chave_refresh_secreta_aqui
JWT_REFRESH_EXPIRE=30d

# Gov.br Integration
GOVBR_API_URL=https://api.gov.br
GOVBR_API_KEY=sua_chave_govbr_aqui
GOVBR_CLIENT_ID=seu_client_id_govbr
GOVBR_CLIENT_SECRET=seu_client_secret_govbr

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app
SMTP_FROM=noreply@alertabike.com

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID=seu_account_sid
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=+5511999999999

# Notification Service
NOTIFICATION_SERVICE=socket.io
PUSH_NOTIFICATION_KEY=sua_chave_push_aqui

# AWS Configuration (Optional)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=sua_chave_acesso_aws
AWS_SECRET_ACCESS_KEY=sua_chave_secreta_aws
AWS_S3_BUCKET=alerta-bike-bucket

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Configuration
API_VERSION=v1
API_PREFIX=/api/v1

# Geolocation
GEOLOCATION_SERVICE=google
GOOGLE_MAPS_API_KEY=sua_chave_google_maps

# Security
SESSION_SECRET=sua_chave_sessao_secreta_aqui
ENCRYPTION_KEY=sua_chave_criptografia_aqui

# Feature Flags
FEATURE_GOV_BR_AUTH=true
FEATURE_REAL_TIME_ALERTS=true
FEATURE_SMS_NOTIFICATIONS=true
